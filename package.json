{
  "name": "devops-cicd-monitoring-module05",
  "private": true,
  "version": "1.0.0",
  "description": "TaskFlow CI/CD, Docker validation, Cloudflare Workers deploy, and monitoring for internship Module 05",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "lint": "node scripts/lint.mjs",
    "build": "wrangler deploy --dry-run --outdir .worker-build",
    "test:smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply taskflow-module05 --local",
    "db:migrate:remote": "wrangler d1 migrations apply taskflow-module05 --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.159.0" }
}
